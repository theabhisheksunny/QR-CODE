<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security configuration for Universal QR Sharing (Android client).

  The app shares files over a LOCAL network (Wi-Fi / hotspot) with no TLS, so
  it must talk to the backend over plain http://<LAN-IP>:<PORT>. Cleartext is a
  deliberate, scoped decision: it is enabled ONLY for private / link-local IPv4
  ranges, never for the public internet.

  Install location after `npx cap add android`:
    frontend/android/app/src/main/res/xml/network_security_config.xml

  Then reference it from AndroidManifest.xml <application>:
    android:networkSecurityConfig="@xml/network_security_config"

  Note: Android's cleartextTrafficPermitted matches by domain/host, not by CIDR.
  Since LAN IPs are assigned by the router (DHCP) and are not known ahead of
  time, the pragmatic approach is a base config that permits cleartext while the
  app itself only ever targets the user-configured LAN host. If you want to pin
  to a fixed Device-A IP, replace the base-config block below with explicit
  <domain-config> entries listing those IPs.
-->
<network-security-config>
    <!-- Default: cleartext permitted (LAN http sharing has no TLS). -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
      Optional hardening: once you know Device-A's LAN IP, pin cleartext to it
      and flip the base-config above to cleartextTrafficPermitted="false".

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">172.20.10.2</domain>
        <domain includeSubdomains="false">192.168.1.25</domain>
    </domain-config>
    -->
</network-security-config>
